<Window x:Class="Pulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulse"
        Width="260" Height="530"
        WindowStyle="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        SizeToContent="Manual"
        AllowsTransparency="True">

    <Window.Resources>
        <!-- Bar gradients -->
        <LinearGradientBrush x:Key="CyanBar" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00FFF9" Offset="0"/>
            <GradientStop Color="#05D9E8" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="MagentaBar" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF2A6D" Offset="0"/>
            <GradientStop Color="#D1003E" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="YellowBar" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFD700" Offset="0"/>
            <GradientStop Color="#FF9500" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GreenBar" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#39FF14" Offset="0"/>
            <GradientStop Color="#32CD32" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="OrangeBar" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF8C00" Offset="0"/>
            <GradientStop Color="#FF6600" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PurpleBar" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#BD93F9" Offset="0"/>
            <GradientStop Color="#8B5CF6" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RedBar" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF5555" Offset="0"/>
            <GradientStop Color="#E03030" Offset="1"/>
        </LinearGradientBrush>

        <!-- Bar track (visible background) -->
        <SolidColorBrush x:Key="BarTrack" Color="#15FFFFFF"/>

        <!-- Tick mark style -->
        <Style x:Key="BarTick" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <SolidColorBrush Color="#00FFF9" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Neon glow effect for metric values -->
        <DropShadowEffect x:Key="CyanGlow" ShadowDepth="0" BlurRadius="6" Color="#00FFF9" Opacity="0.6"/>
        <DropShadowEffect x:Key="MagentaGlow" ShadowDepth="0" BlurRadius="6" Color="#FF2A6D" Opacity="0.6"/>
        <DropShadowEffect x:Key="YellowGlow" ShadowDepth="0" BlurRadius="6" Color="#FFD700" Opacity="0.6"/>
        <DropShadowEffect x:Key="WhiteGlow" ShadowDepth="0" BlurRadius="5" Color="#FFFFFF" Opacity="0.4"/>
        <DropShadowEffect x:Key="PurpleGlow" ShadowDepth="0" BlurRadius="6" Color="#BD93F9" Opacity="0.6"/>
        <DropShadowEffect x:Key="RedGlow" ShadowDepth="0" BlurRadius="6" Color="#FF5555" Opacity="0.6"/>
        <DropShadowEffect x:Key="TealGlow" ShadowDepth="0" BlurRadius="6" Color="#00CED1" Opacity="0.6"/>
        <!-- Cyberpunk thin scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="6"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid>
                                    <Border Background="#0A000000" CornerRadius="3" Width="6"/>
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="#5000FFF9" CornerRadius="2" Width="4"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Border x:Name="RootBorder" Background="#0A0A14"
            BorderBrush="#2600FFF9" BorderThickness="1"
            ClipToBounds="True" CornerRadius="0">
        <Grid>
            <!-- Corner brackets -->
            <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                    BorderBrush="#00FFF9" BorderThickness="1,1,0,0"/>
            <Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"
                    BorderBrush="#00FFF9" BorderThickness="0,1,1,0"/>
            <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    BorderBrush="#00FFF9" BorderThickness="1,0,0,1"/>
            <Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    BorderBrush="#00FFF9" BorderThickness="0,0,1,1"/>

            <!-- Scanline -->
            <Rectangle x:Name="ScanlineRect" Height="4" VerticalAlignment="Top"
                       IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#00FFF9" Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="ScanlineTransform" Y="-4"/>
                </Rectangle.RenderTransform>
                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Style.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.03" To="0.10" Duration="0:0:2"
                                                         AutoReverse="True" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>

            <!-- Main content -->
            <DockPanel>
                <!-- Top bar (drag area) -->
                <DockPanel x:Name="TopBar" DockPanel.Dock="Top"
                           MouseLeftButtonDown="TopBar_MouseLeftButtonDown"
                           Background="Transparent" Height="28">
                    <Border DockPanel.Dock="Bottom" Height="1" Background="#1A00FFF9"/>

                    <Border x:Name="DotsButton" MouseLeftButtonDown="Dots_MouseLeftButtonDown"
                            Background="Transparent" Cursor="Hand" ToolTip="设置"
                            CornerRadius="2" Padding="6,2" Margin="4,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1A00FFF9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="4" Height="4" Fill="#00FFF9" Margin="0,0,3,0"
                                     Effect="{StaticResource CyanGlow}"/>
                            <Ellipse Width="4" Height="4" Fill="#FF2A6D" Margin="0,0,3,0"
                                     Effect="{StaticResource MagentaGlow}"/>
                            <Ellipse Width="4" Height="4" Fill="#FFD700" Margin="0,0,3,0"
                                     Effect="{StaticResource YellowGlow}"/>
                            <TextBlock Text="PULSE" FontFamily="Consolas" FontSize="10"
                                       Foreground="#7F00FFF9" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Right" Margin="0,0,10,0">
                        <TextBlock x:Name="DateLabel" Text="----/--/--"
                                   FontFamily="Consolas" FontSize="10"
                                   Foreground="#BF00FFF9"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <!-- Pin/Topmost toggle -->
                        <Button x:Name="PinToggle" Click="PinToggle_Click"
                                Width="18" Height="18" Margin="0,0,3,0"
                                FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                Foreground="#B300FFF9" Background="Transparent"
                                BorderBrush="#6600FFF9" BorderThickness="1"
                                Content="T"
                                VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center"
                                Cursor="Hand"
                                ToolTip="置顶 / 取消置顶"/>
                        <!-- Lock position toggle -->
                        <Button x:Name="LockToggle" Click="LockToggle_Click"
                                Width="18" Height="18" Margin="0,0,3,0"
                                FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                Foreground="#B300FFF9" Background="Transparent"
                                BorderBrush="#6600FFF9" BorderThickness="1"
                                Content="L"
                                VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center"
                                Cursor="Hand"
                                ToolTip="锁定位置 / 解锁拖动"/>
                        <!-- Compact toggle -->
                        <Button x:Name="CompactToggle" Click="CompactToggle_Click"
                                Width="18" Height="18"
                                FontFamily="Consolas" FontSize="10"
                                Foreground="#B300FFF9" Background="Transparent"
                                BorderBrush="#6600FFF9" BorderThickness="1"
                                Content="&#x25A3;"
                                VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center"
                                Cursor="Hand"
                                ToolTip="简洁模式"/>
                    </StackPanel>
                </DockPanel>

                <!-- Bottom bar -->
                <Grid DockPanel.Dock="Bottom" Height="22">
                    <Border Height="1" VerticalAlignment="Top" Background="#1400FFF9"/>
                    <!-- Left: version + opacity bar -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Left" Margin="10,0,0,0">
                         <TextBlock Text="v0.10" FontFamily="Consolas" FontSize="9"
                                   Foreground="#26FFFFFF" VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <Grid x:Name="OpacityBar" Width="60" Height="14"
                              VerticalAlignment="Center" Cursor="Hand" ToolTip="背景透明度"
                              Background="#08000000"
                              MouseLeftButtonDown="OpacityBar_MouseDown"
                              MouseMove="OpacityBar_MouseMove"
                              MouseLeftButtonUp="OpacityBar_MouseUp">
                            <!-- Track -->
                            <Rectangle Height="4" RadiusX="2" RadiusY="2"
                                       Fill="#15FFFFFF" VerticalAlignment="Center"/>
                            <!-- Fill indicator -->
                            <Rectangle x:Name="OpacityFill" Height="4" RadiusX="2" RadiusY="2"
                                       Fill="#00FFF9" Opacity="0.7" VerticalAlignment="Center"
                                       HorizontalAlignment="Left" Width="60"/>
                            <!-- Thumb dot -->
                            <Ellipse x:Name="OpacityThumb" Width="8" Height="8"
                                     Fill="#00FFF9" VerticalAlignment="Center"
                                     HorizontalAlignment="Right" Margin="0,0,0,0"
                                     Effect="{StaticResource CyanGlow}"/>
                        </Grid>
                    </StackPanel>
                    <!-- Clock: centered; Uptime: positioned right of clock via code-behind -->
                    <TextBlock x:Name="ClockLabel" Text="--:--:--"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="#BF00FFF9"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Effect="{StaticResource CyanGlow}"/>
                    <TextBlock x:Name="UptimeLabel" Text=""
                               FontFamily="Consolas" FontSize="11"
                               Foreground="#4D00FFF9"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               ToolTip="系统运行时间"/>
                    <!-- Far right: exit button -->
                    <Button x:Name="ExitButton" Click="ExitButton_Click"
                            Width="16" Height="16"
                            FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                            Foreground="#FF5555" Background="#18FF5555"
                            BorderBrush="#80FF5555" BorderThickness="1"
                            Content="&#x2715;"
                            VerticalAlignment="Center" VerticalContentAlignment="Center"
                            HorizontalAlignment="Right" HorizontalContentAlignment="Center"
                            Margin="0,0,8,0"
                            Cursor="Hand" ToolTip="退出程序"
                            Effect="{StaticResource RedGlow}"/>
                </Grid>

                <!-- Metrics content (scrollable) -->
                <ScrollViewer x:Name="MetricsScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                <StackPanel Margin="10,8,10,6" VerticalAlignment="Top">
                    <!-- CPU -->
                    <Grid x:Name="CpuSection" Margin="0,0,0,7">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel x:Name="CpuHeaderRow" Grid.Row="0">
                             <TextBlock x:Name="CpuLabel" Text="CPU" FontFamily="Consolas"
                                        FontSize="11" FontWeight="Bold" Foreground="#00FFF9"
                                        Effect="{StaticResource CyanGlow}"/>
                             <TextBlock x:Name="CpuValue" Text="--%" FontFamily="Consolas"
                                        FontSize="13" Foreground="#00FFF9"
                                        HorizontalAlignment="Right"
                                        Effect="{StaticResource CyanGlow}"/>
                        </DockPanel>
                        <Grid x:Name="CpuBarContainer" Grid.Row="1" Height="8" Margin="0,3,0,0">
                            <Border Background="{StaticResource BarTrack}"/>
                            <Rectangle x:Name="CpuFill" HorizontalAlignment="Left" Width="0"
                                       Fill="{StaticResource CyanBar}"/>
                            <UniformGrid Rows="1" IsHitTestVisible="False">
                                <Border Style="{StaticResource BarTick}"/>
                                <Border Style="{StaticResource BarTick}"/>
                                <Border Style="{StaticResource BarTick}"/>
                                <Border Style="{StaticResource BarTick}"/>
                                <Border Style="{StaticResource BarTick}"/>
                                <Border Style="{StaticResource BarTick}"/>
                                <Border Style="{StaticResource BarTick}"/>
                                <Border Style="{StaticResource BarTick}"/>
                                <Border Style="{StaticResource BarTick}"/>
                                <Border/>
                            </UniformGrid>
                        </Grid>
                    </Grid>

                    <!-- RAM -->
                    <Grid x:Name="RamSection" Margin="0,0,0,7">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel x:Name="RamHeaderRow" Grid.Row="0">
                             <TextBlock x:Name="RamLabel" Text="RAM" FontFamily="Consolas"
                                        FontSize="11" FontWeight="Bold" Foreground="#FF2A6D"
                                        Effect="{StaticResource MagentaGlow}"/>
                             <TextBlock x:Name="RamValue" Text="--" FontFamily="Consolas"
                                        FontSize="13" Foreground="#FF2A6D"
                                        HorizontalAlignment="Right"
                                        Effect="{StaticResource MagentaGlow}"/>
                        </DockPanel>
                        <Grid x:Name="RamBarContainer" Grid.Row="1" Height="8" Margin="0,3,0,0">
                            <Border Background="{StaticResource BarTrack}"/>
                            <Rectangle x:Name="RamFill" HorizontalAlignment="Left" Width="0"
                                       Fill="{StaticResource MagentaBar}"/>
                            <UniformGrid Rows="1" IsHitTestVisible="False">
                                <Border Style="{StaticResource BarTick}"/>
                                <Border Style="{StaticResource BarTick}"/>
                                <Border Style="{StaticResource BarTick}"/>
                                <Border Style="{StaticResource BarTick}"/>
                                <Border Style="{StaticResource BarTick}"/>
                                <Border Style="{StaticResource BarTick}"/>
                                <Border Style="{StaticResource BarTick}"/>
                                <Border Style="{StaticResource BarTick}"/>
                                <Border Style="{StaticResource BarTick}"/>
                                <Border/>
                            </UniformGrid>
                        </Grid>
                    </Grid>

                    <!-- GPU -->
                    <Grid x:Name="GpuSection" Margin="0,0,0,7">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel x:Name="GpuHeaderRow" Grid.Row="0">
                             <TextBlock x:Name="GpuLabel" Text="GPU" FontFamily="Consolas"
                                        FontSize="11" FontWeight="Bold" Foreground="#FFD700"
                                        Effect="{StaticResource YellowGlow}"/>
                             <TextBlock x:Name="GpuValue" Text="N/A" FontFamily="Consolas"
                                        FontSize="13" Foreground="#FFD700"
                                        HorizontalAlignment="Right"
                                        Effect="{StaticResource YellowGlow}"/>
                        </DockPanel>
                        <Grid x:Name="GpuBarContainer" Grid.Row="1" Height="8" Margin="0,3,0,0">
                            <Border Background="{StaticResource BarTrack}"/>
                            <Rectangle x:Name="GpuFill" HorizontalAlignment="Left" Width="0"
                                       Fill="{StaticResource YellowBar}"/>
                            <UniformGrid Rows="1" IsHitTestVisible="False">
                                <Border Style="{StaticResource BarTick}"/>
                                <Border Style="{StaticResource BarTick}"/>
                                <Border Style="{StaticResource BarTick}"/>
                                <Border Style="{StaticResource BarTick}"/>
                                <Border Style="{StaticResource BarTick}"/>
                                <Border Style="{StaticResource BarTick}"/>
                                <Border Style="{StaticResource BarTick}"/>
                                <Border Style="{StaticResource BarTick}"/>
                                <Border Style="{StaticResource BarTick}"/>
                                <Border/>
                            </UniformGrid>
                        </Grid>
                    </Grid>

                     <!-- NET -->
                     <Grid x:Name="NetSection" Margin="0,0,0,7">
                         <Grid.RowDefinitions>
                             <RowDefinition Height="Auto"/>
                             <RowDefinition Height="Auto"/>
                         </Grid.RowDefinitions>
                         <DockPanel x:Name="NetHeaderRow" Grid.Row="0">
                              <TextBlock x:Name="NetLabel" Text="NET" FontFamily="Consolas"
                                         FontSize="11" FontWeight="Bold" Foreground="#D9FFFFFF"
                                         Effect="{StaticResource WhiteGlow}"/>
                              <TextBlock x:Name="NetValue" Text="0 / 0" FontFamily="Consolas"
                                         FontSize="13" Foreground="#E6FFFFFF"
                                         HorizontalAlignment="Right"
                                         Effect="{StaticResource WhiteGlow}"/>
                         </DockPanel>
                         <Grid Grid.Row="1" Margin="0,3,0,0" x:Name="NetBarsGrid">
                             <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="*"/>
                                 <ColumnDefinition Width="6"/>
                                 <ColumnDefinition Width="*"/>
                             </Grid.ColumnDefinitions>
                             <StackPanel Grid.Column="0">
                                 <TextBlock x:Name="NetUpTag" Text="UP" FontFamily="Consolas"
                                            FontSize="9" Foreground="#B339FF14" Margin="0,0,0,2"/>
                                 <Grid x:Name="NetUpBarContainer" Height="6">
                                     <Border Background="{StaticResource BarTrack}"/>
                                     <Rectangle x:Name="NetUpFill" HorizontalAlignment="Left" Width="0"
                                                Fill="{StaticResource GreenBar}" Opacity="0.8"/>
                                 </Grid>
                             </StackPanel>
                             <StackPanel Grid.Column="2">
                                 <TextBlock x:Name="NetDnTag" Text="DN" FontFamily="Consolas"
                                            FontSize="9" Foreground="#B3FF8C00" Margin="0,0,0,2"/>
                                 <Grid x:Name="NetDnBarContainer" Height="6">
                                     <Border Background="{StaticResource BarTrack}"/>
                                     <Rectangle x:Name="NetDnFill" HorizontalAlignment="Left" Width="0"
                                                Fill="{StaticResource OrangeBar}" Opacity="0.8"/>
                                 </Grid>
                             </StackPanel>
                         </Grid>
                      </Grid>

                     <!-- PING (latency to 223.5.5.5) -->
                     <Grid x:Name="PingSection" Margin="0,0,0,7">
                         <Grid.RowDefinitions>
                             <RowDefinition Height="Auto"/>
                             <RowDefinition Height="Auto"/>
                         </Grid.RowDefinitions>
                         <DockPanel x:Name="PingHeaderRow" Grid.Row="0">
                               <TextBlock x:Name="PingLabel" Text="DELAY(223.5.5.5)" FontFamily="Consolas"
                                         FontSize="11" FontWeight="Bold" Foreground="#39FF14"
                                         Effect="{StaticResource CyanGlow}"/>
                              <TextBlock x:Name="PingValue" Text="N/A" FontFamily="Consolas"
                                         FontSize="13" Foreground="#39FF14"
                                         HorizontalAlignment="Right"
                                         Effect="{StaticResource CyanGlow}"/>
                         </DockPanel>
                         <Grid x:Name="PingBarContainer" Grid.Row="1" Height="8" Margin="0,3,0,0">
                             <Border Background="{StaticResource BarTrack}"/>
                             <Rectangle x:Name="PingFill" HorizontalAlignment="Left" Width="0"
                                        Fill="{StaticResource GreenBar}"/>
                             <UniformGrid Rows="1" IsHitTestVisible="False">
                                 <Border Style="{StaticResource BarTick}"/>
                                 <Border Style="{StaticResource BarTick}"/>
                                 <Border Style="{StaticResource BarTick}"/>
                                 <Border Style="{StaticResource BarTick}"/>
                                 <Border Style="{StaticResource BarTick}"/>
                                 <Border Style="{StaticResource BarTick}"/>
                                 <Border Style="{StaticResource BarTick}"/>
                                 <Border Style="{StaticResource BarTick}"/>
                                 <Border Style="{StaticResource BarTick}"/>
                                 <Border/>
                             </UniformGrid>
                         </Grid>
                     </Grid>

                     <!-- ADDR (local IP address) -->
                     <Grid x:Name="AddrSection" Margin="0,0,0,7">
                         <DockPanel x:Name="AddrHeaderRow">
                               <TextBlock x:Name="AddrLabel" Text="IP ADDR" FontFamily="Consolas"
                                         FontSize="11" FontWeight="Bold" Foreground="#BD93F9"
                                         Effect="{StaticResource PurpleGlow}"/>
                              <TextBlock x:Name="AddrValue" Text="N/A" FontFamily="Consolas"
                                         FontSize="11" Foreground="#BD93F9"
                                         HorizontalAlignment="Right"
                                         Effect="{StaticResource PurpleGlow}"/>
                         </DockPanel>
                     </Grid>

                     <!-- DNS -->
                     <Grid x:Name="DnsSection" Margin="0,0,0,7">
                         <DockPanel x:Name="DnsHeaderRow">
                              <TextBlock x:Name="DnsLabel" Text="IP DNS" FontFamily="Consolas"
                                         FontSize="11" FontWeight="Bold" Foreground="#BD93F9"
                                         Effect="{StaticResource PurpleGlow}"/>
                              <TextBlock x:Name="DnsValue" Text="N/A" FontFamily="Consolas"
                                         FontSize="11" Foreground="#BD93F9"
                                         HorizontalAlignment="Right"
                                         Effect="{StaticResource PurpleGlow}"/>
                         </DockPanel>
                     </Grid>

                      <!-- PROC -->
                     <Grid x:Name="ProcSection" Margin="0,0,0,7">
                         <Grid.RowDefinitions>
                             <RowDefinition Height="Auto"/>
                             <RowDefinition Height="Auto"/>
                         </Grid.RowDefinitions>
                         <DockPanel x:Name="ProcHeaderRow" Grid.Row="0">
                              <TextBlock x:Name="ProcLabel" Text="PROC" FontFamily="Consolas"
                                         FontSize="11" FontWeight="Bold" Foreground="#00CED1"
                                         Effect="{StaticResource TealGlow}"/>
                              <TextBlock x:Name="ProcValue" Text="--" FontFamily="Consolas"
                                         FontSize="13" Foreground="#00CED1"
                                         HorizontalAlignment="Right"
                                         Effect="{StaticResource TealGlow}"/>
                         </DockPanel>
                         <Grid x:Name="ProcBarContainer" Grid.Row="1" Height="8" Margin="0,3,0,0">
                             <Border Background="{StaticResource BarTrack}"/>
                             <Rectangle x:Name="ProcFill" HorizontalAlignment="Left" Width="0"
                                        Fill="{StaticResource CyanBar}" Opacity="0.5"/>
                             <UniformGrid Rows="1" IsHitTestVisible="False">
                                 <Border Style="{StaticResource BarTick}"/>
                                 <Border Style="{StaticResource BarTick}"/>
                                 <Border Style="{StaticResource BarTick}"/>
                                 <Border Style="{StaticResource BarTick}"/>
                                 <Border Style="{StaticResource BarTick}"/>
                                 <Border Style="{StaticResource BarTick}"/>
                                 <Border Style="{StaticResource BarTick}"/>
                                 <Border Style="{StaticResource BarTick}"/>
                                 <Border Style="{StaticResource BarTick}"/>
                                 <Border/>
                             </UniformGrid>
                         </Grid>
                     </Grid>

                     <!-- WIFI (signal strength) -->
                     <Grid x:Name="WifiSection" Margin="0,0,0,7">
                         <Grid.RowDefinitions>
                             <RowDefinition Height="Auto"/>
                             <RowDefinition Height="Auto"/>
                         </Grid.RowDefinitions>
                         <DockPanel x:Name="WifiHeaderRow" Grid.Row="0">
                              <TextBlock x:Name="WifiLabel" Text="WIFI" FontFamily="Consolas"
                                         FontSize="11" FontWeight="Bold" Foreground="#39FF14"
                                         Effect="{StaticResource CyanGlow}"/>
                              <TextBlock x:Name="WifiValue" Text="N/A" FontFamily="Consolas"
                                         FontSize="13" Foreground="#39FF14"
                                         HorizontalAlignment="Right"
                                         Effect="{StaticResource CyanGlow}"/>
                         </DockPanel>
                         <Grid x:Name="WifiBarContainer" Grid.Row="1" Height="8" Margin="0,3,0,0">
                             <Border Background="{StaticResource BarTrack}"/>
                             <Rectangle x:Name="WifiFill" HorizontalAlignment="Left" Width="0"
                                        Fill="{StaticResource GreenBar}"/>
                             <UniformGrid Rows="1" IsHitTestVisible="False">
                                 <Border Style="{StaticResource BarTick}"/>
                                 <Border Style="{StaticResource BarTick}"/>
                                 <Border Style="{StaticResource BarTick}"/>
                                 <Border Style="{StaticResource BarTick}"/>
                                 <Border Style="{StaticResource BarTick}"/>
                                 <Border Style="{StaticResource BarTick}"/>
                                 <Border Style="{StaticResource BarTick}"/>
                                 <Border Style="{StaticResource BarTick}"/>
                                 <Border Style="{StaticResource BarTick}"/>
                                 <Border/>
                             </UniformGrid>
                         </Grid>
                     </Grid>

                      <!-- TEMP (CPU / GPU dual temperature, like NET UP/DN layout) - last -->
                     <Grid x:Name="TempSection">
                         <Grid.RowDefinitions>
                             <RowDefinition Height="Auto"/>
                             <RowDefinition Height="Auto"/>
                         </Grid.RowDefinitions>
                         <DockPanel x:Name="TempHeaderRow" Grid.Row="0">
                              <TextBlock x:Name="TempLabel" Text="TEMP" FontFamily="Consolas"
                                         FontSize="11" FontWeight="Bold" Foreground="#FF5555"
                                         Effect="{StaticResource RedGlow}"/>
                              <TextBlock x:Name="TempValue" Text="N/A" FontFamily="Consolas"
                                         FontSize="13" Foreground="#E6FFFFFF"
                                         HorizontalAlignment="Right"
                                         Effect="{StaticResource WhiteGlow}"/>
                         </DockPanel>
                         <Grid Grid.Row="1" Margin="0,3,0,0" x:Name="TempBarsGrid">
                             <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="*"/>
                                 <ColumnDefinition Width="6"/>
                                 <ColumnDefinition Width="*"/>
                             </Grid.ColumnDefinitions>
                             <StackPanel Grid.Column="0">
                                 <TextBlock x:Name="TempCpuTag" Text="CPU" FontFamily="Consolas"
                                            FontSize="9" Foreground="#B300FFF9" Margin="0,0,0,2"/>
                                 <Grid x:Name="TempCpuBarContainer" Height="6">
                                     <Border Background="{StaticResource BarTrack}"/>
                                     <Rectangle x:Name="TempCpuFill" HorizontalAlignment="Left" Width="0"
                                                Fill="{StaticResource CyanBar}" Opacity="0.8"/>
                                 </Grid>
                             </StackPanel>
                             <StackPanel Grid.Column="2">
                                 <TextBlock x:Name="TempGpuTag" Text="GPU" FontFamily="Consolas"
                                            FontSize="9" Foreground="#B3FFD700" Margin="0,0,0,2"/>
                                 <Grid x:Name="TempGpuBarContainer" Height="6">
                                     <Border Background="{StaticResource BarTrack}"/>
                                     <Rectangle x:Name="TempGpuFill" HorizontalAlignment="Left" Width="0"
                                                Fill="{StaticResource YellowBar}" Opacity="0.8"/>
                                 </Grid>
                             </StackPanel>
                         </Grid>
                     </Grid>
                 </StackPanel>
                </ScrollViewer>
             </DockPanel>
         </Grid>
     </Border>
 </Window>