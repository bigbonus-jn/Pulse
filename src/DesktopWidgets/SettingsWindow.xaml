<Window x:Class="Pulse.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulse Settings"
        Width="280"
        MaxHeight="500"
        WindowStyle="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        AllowsTransparency="True">

    <Window.Resources>
        <DropShadowEffect x:Key="CyanGlow" ShadowDepth="0" BlurRadius="6" Color="#00FFF9" Opacity="0.6"/>
        <DropShadowEffect x:Key="RedGlow" ShadowDepth="0" BlurRadius="6" Color="#FF5555" Opacity="0.6"/>

        <!-- Cyberpunk checkbox style (implicit — applies to all CheckBoxes in this window) -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#00FFF9"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckBoxBorder" Width="16" Height="16"
                                    BorderBrush="#6600FFF9" BorderThickness="1"
                                    Background="#050510" Margin="0,0,8,0"
                                    CornerRadius="1">
                                <TextBlock x:Name="CheckMark" Text="&#x2713;"
                                           FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                           Foreground="#00FFF9"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#00FFF9"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#00FFF9"/>
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#0A1520"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyberpunk textbox style -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#00FFF9"/>
            <Setter Property="Background" Value="#050510"/>
            <Setter Property="BorderBrush" Value="#6600FFF9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="CaretBrush" Value="#00FFF9"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="1">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00FFF9"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00FFF9"/>
                                <Setter TargetName="Bd" Property="Background" Value="#0A1520"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyberpunk scrollbar (same as main window) -->
        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="6"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid>
                                    <Border Background="#0A000000" CornerRadius="3" Width="6"/>
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="#5000FFF9" CornerRadius="2" Width="4"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="SettingsRootBorder" Background="#0A0A14" BorderBrush="#2600FFF9" BorderThickness="1" CornerRadius="0">
        <Grid>
            <!-- Corner brackets -->
            <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                    BorderBrush="#00FFF9" BorderThickness="1,1,0,0"/>
            <Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"
                    BorderBrush="#00FFF9" BorderThickness="0,1,1,0"/>
            <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    BorderBrush="#00FFF9" BorderThickness="1,0,0,1"/>
            <Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    BorderBrush="#00FFF9" BorderThickness="0,0,1,1"/>

            <DockPanel>
                <!-- Title bar (draggable) -->
                <DockPanel x:Name="TitleBar" DockPanel.Dock="Top" Height="28"
                           MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                           Background="Transparent">
                    <Border DockPanel.Dock="Bottom" Height="1" Background="#1A00FFF9"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Ellipse Width="4" Height="4" Fill="#00FFF9" Margin="0,0,4,0"/>
                        <Ellipse Width="4" Height="4" Fill="#FF2A6D" Margin="0,0,4,0"/>
                        <Ellipse Width="4" Height="4" Fill="#FFD700" Margin="0,0,4,0"/>
                        <TextBlock Text="SETTINGS" FontFamily="Consolas" FontSize="10"
                                   Foreground="#7F00FFF9" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Right" Margin="0,0,8,0">
                        <!-- Lock/follow toggle -->
                        <Button x:Name="FollowToggle" Click="FollowToggle_Click"
                                Width="18" Height="18" Margin="0,0,3,0"
                                FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                Foreground="#B300FFF9" Background="Transparent"
                                BorderBrush="#6600FFF9" BorderThickness="1"
                                Content="L"
                                VerticalAlignment="Center" VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center"
                                Cursor="Hand"
                                ToolTip="锁定跟随主窗口 / 解锁自由拖动"/>
                        <!-- Close -->
                        <Button x:Name="CloseButton" Click="CloseButton_Click"
                                Width="16" Height="16"
                                FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                Foreground="#FF5555" Background="#18FF5555"
                                BorderBrush="#80FF5555" BorderThickness="1"
                                Content="&#x2715;"
                                VerticalAlignment="Center" VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center"
                                Cursor="Hand"
                                Effect="{StaticResource RedGlow}"/>
                    </StackPanel>
                </DockPanel>

                <!-- Content -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,12,16,16">
                        <!-- Section: Monitor Visibility -->
                        <TextBlock Text="// MONITORS" FontFamily="Consolas" FontSize="11"
                                   Foreground="#6000FFF9" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Border Height="1" Background="#1400FFF9" Margin="0,0,0,8"/>
                        <TextBlock Text="勾选需要显示的监控项，CPU 为基础项不可关闭"
                                   FontFamily="Consolas" FontSize="9" Foreground="#40FFFFFF"
                                   Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <StackPanel x:Name="MonitorCheckList"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</Window>
