<Window x:Class="Pulse.NetworkCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Check"
        Width="340"
        WindowStyle="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        AllowsTransparency="True"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <DropShadowEffect x:Key="CyanGlow" ShadowDepth="0" BlurRadius="6" Color="#00FFF9" Opacity="0.6"/>
        <DropShadowEffect x:Key="RedGlow" ShadowDepth="0" BlurRadius="6" Color="#FF5555" Opacity="0.6"/>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#B300FFF9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#6600FFF9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1400FFF9"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#B300FFF9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="CheckRootBorder" Background="#0A0A14" BorderBrush="#2600FFF9"
            BorderThickness="1" CornerRadius="0">
        <Grid>
            <!-- Corner brackets -->
            <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                    BorderBrush="#00FFF9" BorderThickness="1,1,0,0"/>
            <Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"
                    BorderBrush="#00FFF9" BorderThickness="0,1,1,0"/>
            <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    BorderBrush="#00FFF9" BorderThickness="1,0,0,1"/>
            <Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    BorderBrush="#00FFF9" BorderThickness="0,0,1,1"/>

            <DockPanel>
                <!-- Title bar -->
                <DockPanel DockPanel.Dock="Top" Height="28"
                           MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                           Background="Transparent">
                    <Border DockPanel.Dock="Bottom" Height="1" Background="#1A00FFF9"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Ellipse Width="4" Height="4" Fill="#00FFF9" Margin="0,0,4,0"/>
                        <Ellipse Width="4" Height="4" Fill="#FF2A6D" Margin="0,0,4,0"/>
                        <Ellipse Width="4" Height="4" Fill="#FFD700" Margin="0,0,4,0"/>
                        <TextBlock Text="NETWORK CHECK" FontFamily="Consolas" FontSize="10"
                                   Foreground="#7F00FFF9" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="CloseButton" Click="CloseButton_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                            Width="16" Height="16"
                            FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                            Foreground="#FF5555" Background="#18FF5555"
                            BorderBrush="#80FF5555" BorderThickness="1"
                            Content="&#x2715;"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                            Cursor="Hand" Effect="{StaticResource RedGlow}"/>
                </DockPanel>

                <!-- Content -->
                <StackPanel Margin="16,12,16,14">
                    <!-- Score header -->
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ScoreLabel" Text="--" FontFamily="Consolas"
                                       FontSize="34" FontWeight="Bold" Foreground="#00FFF9"
                                       Effect="{StaticResource CyanGlow}"/>
                            <TextBlock Text="/100" FontFamily="Consolas" FontSize="12"
                                       Foreground="#6000FFF9" VerticalAlignment="Bottom" Margin="3,0,0,6"/>
                        </StackPanel>
                        <TextBlock x:Name="GradeLabel" Text="" FontFamily="Consolas"
                                   FontSize="22" FontWeight="Bold" Foreground="#00FFF9"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Height="1" Background="#1400FFF9" Margin="0,0,0,8"/>
                    <TextBlock x:Name="AdviceLabel" Text="正在检测网络健康度…"
                               FontFamily="Consolas" FontSize="10" Foreground="#80FFFFFF"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <!-- Check rows (dynamic) -->
                    <StackPanel x:Name="CheckList"/>

                    <!-- Footer -->
                    <Grid Margin="0,12,0,0">
                        <TextBlock x:Name="StatusLabel" Text="" FontFamily="Consolas"
                                   FontSize="9" Foreground="#5000FFF9" VerticalAlignment="Center"/>
                        <Button x:Name="RetryButton" Content="↻ 重新检测" Style="{StaticResource ActionButton}"
                                HorizontalAlignment="Right" Click="RetryButton_Click"/>
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>